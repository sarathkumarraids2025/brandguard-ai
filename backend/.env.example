# BRANDGUARD AI - Environment Configuration

# Application
APP_NAME="BRANDGUARD AI"
APP_ENV="development"
PORT=8000
HOST="127.0.0.1"
SECRET_KEY="brandguard-ai-hackathon-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite in project root. For production: postgresql://user:pass@localhost:5432/brandguard
DATABASE_URL="sqlite:///./brandguard.db"

# Optional External AI API Key (Groq / OpenAI / Gemini)
# System will automatically use high-performance local deterministic fallback if unset
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# File Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=["pdf", "docx", "txt", "csv", "png", "jpg", "jpeg", "webp"]

# Security
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:8000", "http://localhost:8000"]
